[
  {
    "id": "deploy",
    "execute-command": "{{ getenv `HOST_WEBHOOK_DIR` }}/deploy.sh",
    "command-working-directory": "{{ getenv `HOST_WEBHOOK_DIR` }}",
    "include-command-output-in-response": true,
    "include-command-output-in-response-on-error": true,
    "trigger-rule": {
      "match": {
        "type": "value",
        "value": "{{ getenv `DEPLOY_SECRET` }}",
        "parameter": {
          "source": "header",
          "name": "X-Deploy-Secret"
        }
      }
    }
  }
]
